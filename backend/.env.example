LLM_MODE=fake
ADMIN_INVITE_CODE=TABLE2
DATABASE_PATH=roundtable.db
FAKE_LLM_DELAY=0.03
SESSION_COOKIE_SECURE=0
DEFAULT_MONTHLY_LIMIT_CNY=
USD_CNY_RATE=7.2
# 多个模型用逗号分隔，每项为 模型名=显示名，显示名可省略
# EXTRA_MODELS=openai/gpt-6.1-sol=GPT-6.1 Sol,ollama/qwen3:8b
EXTRA_MODELS=
ROUNDTABLE_ANTHROPIC_MODEL=anthropic/claude-haiku-5-5
ROUNDTABLE_OPENAI_MODEL=openai/gpt-5-mini
ROUNDTABLE_DEEPSEEK_MODEL=deepseek/deepseek-flash
# 直连官方：填 ANTHROPIC_API_KEY。走中转站：填下面两行，不填 ANTHROPIC_API_KEY
# 地址末尾不要加 /v1，LiteLLM 会自己拼上 /v1/messages
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-anthropic-relay.example.com
# ANTHROPIC_AUTH_TOKEN=
# 走中转站时填 OPENAI_BASE_URL。注意：OpenAI 的地址末尾要带 /v1（和 Anthropic 相反）
# OPENAI_BASE_URL=https://your-openai-relay.example.com/v1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 真实模式须先构建 Docker 镜像。假模型模式使用模拟沙箱。
SANDBOX_ENABLED=0
SANDBOX_IMAGE=roundtable-sandbox
SANDBOX_TIMEOUT=20
SANDBOX_MAX_PARALLEL=2
SANDBOX_MAX_RUNS_PER_TURN=5
SANDBOX_MEMORY=512m
# LiteLLM 尚未识别但已确认支持工具的模型，逗号分隔
TOOL_MODELS=
